---
import { intents } from '../data/site';

interface Props {
  title?: string;
  body?: string;
  lead?: string[];
}

const {
  title = 'We’ve sat in your seat.',
  body = 'Tell us what you’re working on and we’ll set up a conversation with the principal who has done it before.',
  lead = [],
} = Astro.props;

const ordered = [
  ...lead.map((id) => intents.find((i) => i.id === id)!).filter(Boolean),
  ...intents.filter((i) => !lead.includes(i.id)),
];
---

<section class="cta" aria-labelledby="cta-title">
  <canvas class="cta__field" data-field="band" aria-hidden="true"></canvas>
  <div class="wrap cta__in">
    <div>
      <h2 id="cta-title">{title}</h2>
      <p>{body}</p>
    </div>
    <ul class="intents">
      {ordered.map((i) => (
        <li>
          <a href={`/contact?topic=${i.id}`}>
            <strong>{i.label}</strong>
            <span class="intents__desc">{i.desc}</span>
            <span class="intents__go" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
