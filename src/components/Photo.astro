---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  width?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
  style?: string;
}

const { class: cls, ...rest } = Astro.props;
---

<span class:list={['ph', cls]}><Image {...rest} data-fade /></span>
