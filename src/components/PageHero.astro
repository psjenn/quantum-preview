---
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<section class="hero hero--page">
  <canvas class="hero__field" data-field="hero" aria-hidden="true"></canvas>
  <div class="wrap hero__in">
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>
