---
import { Image } from 'astro:assets';
import { clientGroups } from '../data/site';
import { colorLogo } from '../lib/images';

const mixed: (readonly [string, string])[] = [];
const longest = Math.max(...clientGroups.map((g) => g.teams.length));
for (let i = 0; i < longest; i++) for (const g of clientGroups) if (g.teams[i]) mixed.push(g.teams[i]);
const rows = [mixed.filter((_, i) => i % 2 === 0), mixed.filter((_, i) => i % 2 === 1)];

// Same height makes wide marks read much bigger than crests. Scale height by
// aspect ratio so every logo covers roughly the same visual area.
const optical = (slug: string) => {
  const { width, height } = colorLogo(slug);
  const s = Math.min(1.12, Math.max(0.55, (width / height) ** -0.65));
  return `--s:${s.toFixed(3)}`;
};
---

<div class="roll" data-roll>
  {rows.map((row, r) => (
    <div class:list={['roll__row', { 'roll__row--rev': r === 1 }]}>
      <div class="roll__track">
        <ul class="roll__set" aria-label={r === 0 ? 'Selected clients' : undefined}>
          {row.map(([slug, name]) => (
            <li><Image src={colorLogo(slug)} alt={name} title={name} height={144} style={optical(slug)} /></li>
          ))}
        </ul>
        {/* Duplicate set for a seamless loop */}
        <ul class="roll__set" aria-hidden="true">
          {row.map(([slug]) => (
            <li><Image src={colorLogo(slug)} alt="" height={144} style={optical(slug)} /></li>
          ))}
        </ul>
      </div>
    </div>
  ))}
  <button class="roll__toggle" type="button" data-roll-toggle aria-pressed="false">Pause</button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-roll]').forEach((roll) => {
    const btn = roll.querySelector<HTMLButtonElement>('[data-roll-toggle]');
    btn?.addEventListener('click', () => {
      const paused = roll.toggleAttribute('data-paused');
      btn.setAttribute('aria-pressed', String(paused));
      btn.textContent = paused ? 'Play' : 'Pause';
    });
    // Stop compositing frames while the wall is off screen.
    new IntersectionObserver(([entry]) => {
      roll.toggleAttribute('data-offscreen', !entry.isIntersecting);
    }).observe(roll);
    // Logos reach the viewport by sliding sideways, which native lazy-loading
    // (Safari especially) doesn't notice, leaving blank stretches. Load the whole
    // wall as soon as it nears the viewport vertically instead.
    const near = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        roll.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
        near.disconnect();
      },
      { rootMargin: '800px 0px' },
    );
    near.observe(roll);
  });
</script>
