---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CaseCard from '../components/CaseCard.astro';
import LogoWall from '../components/LogoWall.astro';
import { caseStudies } from '../data/site';
---

<Base title="Our work" description="Case studies from Quantum Sports + Entertainment Group: stadium openings, ticketing turnarounds, executive searches, and partnership deals.">
  <PageHero title="Our work" lede="Stadium openings, ticketing turnarounds, executive searches, and partnership deals." />

  <section class="section" aria-labelledby="cases-title">
    <h2 id="cases-title" class="sr-only">Case studies</h2>
    <div class="wrap cases cases--packed">
      {caseStudies.map((c) => <CaseCard study={c} full />)}
    </div>
  </section>

  <section class="section" aria-labelledby="clients-title">
    <div class="wrap">
      <div class="head"><h2 id="clients-title" class="bar h-mid">Teams, venues, and leagues</h2></div>
      <LogoWall />
    </div>
  </section>
</Base>
