---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import PageHero from '../components/PageHero.astro';
import { advisory } from '../data/pages';
import { stadiums } from '../data/site';
import { photo } from '../lib/images';
---

<Base title="Advisory Services" description={advisory.lede} cta={{ title: 'Opening something new? Talk to people who have.', lead: ['strategy'] }}>
  <PageHero title="Advisory Services" lede={advisory.lede}>
    <div class="actions">
      <a class="btn btn--primary" href="/contact?topic=strategy">Schedule a strategy call</a>
    </div>
  </PageHero>

  <section class="section" aria-label="What we do">
    <div class="wrap">
      <div class="blocks">
        {advisory.blocks.map((b) => <div><h2>{b.title}</h2><p>{b.body}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="stad-title">
    <div class="wrap">
      <div class="head">
        <h2 id="stad-title" class="bar h-mid">Four MLS stadium openings</h2>
        <p class="lede">Part of eleven stadium and arena projects, over $1 billion in all.</p>
      </div>
      <ol class="timeline">
        {stadiums.map((s) => (
          <li>
            <span class="figure">{s.year}</span>
            <Photo src={photo(s.photo)} alt={s.venue} widths={[400, 700]} sizes="(max-width: 30rem) 100vw, (max-width: 56rem) 50vw, 25vw" />
            <h3>{s.venue}</h3>
            <p>{s.team}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
